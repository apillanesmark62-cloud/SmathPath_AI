# Copy to .env for local development:  cp .env.example .env
#
# This is read by the server-side function only (netlify/functions/chat.mjs).
# It is not prefixed with VITE_, so Vite will never include it in the browser
# bundle. Do not add a VITE_ prefix — that would publish it.
#
# On Netlify, set the same variable under:
#   Site configuration -> Environment variables

# --- Anthropic, for the career match, resume and interview features ---
ANTHROPIC_API_KEY=sk-ant-...
