# Copy to .env for local development:  cp .env.example .env
#
# This key is read by the server-side function only (netlify/functions/chat.mjs).
# It is NOT prefixed with VITE_, so Vite will never include it in the browser
# bundle. Do not rename it to VITE_ANTHROPIC_API_KEY — that would publish it.
#
# On Netlify, set the same variable under:
#   Site configuration -> Environment variables
ANTHROPIC_API_KEY=sk-ant-...
