# Copy to .env for local development:  cp .env.example .env
#
# These are read by the server-side functions only (netlify/functions/*.mjs).
# None are prefixed with VITE_, so Vite will never include them in the browser
# bundle. Do not add a VITE_ prefix to any of them — that would publish them.
#
# On Netlify, set the same variables under:
#   Site configuration -> Environment variables

# --- Anthropic, for the career match, resume and interview features ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Strand classifier (AutoTrain model on Hugging Face) ---
# The model's inference URL. Either the serverless Inference API:
#   https://api-inference.huggingface.co/models/<your-username>/<your-model>
# or a dedicated Inference Endpoint:
#   https://<id>.<region>.aws.endpoints.huggingface.cloud
HF_CLASSIFIER_URL=

# A Hugging Face access token with read access to that model.
HF_API_TOKEN=hf_...

# How the model takes its input. "tabular" (the default) sends the eight
# features as columns and one row, which is what AutoTrain tabular
# classification expects. Set it to "text" if the model was trained as a text
# classifier, and the features are sent as one sentence instead.
HF_CLASSIFIER_FORMAT=tabular
