# Copy to .env for local development:  cp .env.example .env
#
# These are read by the server-side functions only (netlify/functions/*.mjs).
# None are prefixed with VITE_, so Vite will never include them in the browser
# bundle. Do not add a VITE_ prefix to any of them — that would publish them.
#
# On Netlify, set the same variables under:
#   Site configuration -> Environment variables

# --- Anthropic, for the career match, resume and interview features ---
ANTHROPIC_API_KEY=sk-ant-...

# --- AutoTrain Decision Tree, for the strand classifier ---

# REQUIRED. The compiled-in default, https://api.autotrain.app/api/autotrain,
# answers 404 {"detail":"Not Found"} — the server is reachable but has no route
# at that path, so the URL is wrong. Get the real one from your Testing
# Console's Network tab, or run: npm run probe:autotrain
AUTOTRAIN_URL=

# Set only if the endpoint starts requiring a key. It is sent as
# "Authorization: Bearer <key>" and stays server-side.
# AUTOTRAIN_API_KEY=

# The model to score against. /api/autotrain is a shared endpoint whose reply
# names a model_id, so if it starts rejecting requests that do not identify a
# model, put the id here. Where the id belongs in the request is undocumented,
# so classify.mjs tries each plausible position and keeps the one that works.
# Find the id in the AutoTrain Testing Console response ("model_id").
# AUTOTRAIN_MODEL_ID=
